import os
import hashlib
import numpy as np
from PIL import Image
import matplotlib.pyplot as plt
import csv
import math
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad, unpad
from Crypto.Random import get_random_bytes
from Crypto.Protocol.KDF import PBKDF2
from skimage.metrics import peak_signal_noise_ratio as psnr
from skimage.metrics import structural_similarity as ssim

# ==========================================
# 1. Вспомогательные функции
# ==========================================
def load_image(path):
    return np.array(Image.open(path).convert('RGB'), dtype=np.uint8)

def save_image(data, path):
    Image.fromarray(data).save(path)

# ==========================================
# 2. Шифрование и Дешифрование
# ==========================================
def encrypt_message(message, password):
    salt = get_random_bytes(16)
    iv = get_random_bytes(16)
    key = PBKDF2(password, salt, dkLen=32)
    cipher = AES.new(key, AES.MODE_CBC, iv)
    ciphertext = cipher.encrypt(pad(message.encode('utf-8'), AES.block_size))
    length_bytes = len(ciphertext).to_bytes(4, 'big')
    return length_bytes + salt + iv + ciphertext

def decrypt_message(enc_data, password):
    length = int.from_bytes(enc_data[:4], 'big')
    salt = enc_data[4:20]
    iv = enc_data[20:36]
    ciphertext = enc_data[36:36+length]
    key = PBKDF2(password, salt, dkLen=32)
    cipher = AES.new(key, AES.MODE_CBC, iv)
    decrypted = unpad(cipher.decrypt(ciphertext), AES.block_size)
    return decrypted.decode('utf-8', errors='ignore')

# ==========================================
# 3. LSB Стеганография
# ==========================================
def embed_lsb_sequential(cover, payload_bytes):
    stego = cover.copy()
    flat_img = stego.flatten().astype(int)
    payload_bits = [int(b) for byte in payload_bytes for b in f'{byte:08b}']
    
    if len(payload_bits) > len(flat_img):
        raise ValueError("Сообщение слишком большое!")
    
    for i, bit in enumerate(payload_bits):
        flat_img[i] = (flat_img[i] & ~1) | bit
        
    return flat_img.astype(np.uint8).reshape(cover.shape)

def embed_lsb_random(cover, payload_bytes, password):
    stego = cover.copy()
    flat_img = stego.flatten().astype(int)
    payload_bits = [int(b) for byte in payload_bytes for b in f'{byte:08b}']
    
    if len(payload_bits) > len(flat_img):
        raise ValueError("Сообщение слишком большое!")
        
    seed = int(hashlib.sha256(password.encode()).hexdigest(), 16) % (2**32)
    np.random.seed(seed)
    indices = np.random.choice(len(flat_img), size=len(payload_bits), replace=False)
    
    for idx, bit in zip(indices, payload_bits):
        flat_img[idx] = (flat_img[idx] & ~1) | bit
        
    return flat_img.astype(np.uint8).reshape(cover.shape)

# ==========================================
# 4. Метрики и Визуализация
# ==========================================
def calculate_metrics(cover, stego):
    p = psnr(cover, stego, data_range=255)
    s = ssim(cover, stego, data_range=255, channel_axis=2)
    diff = np.sum(cover != stego)
    total = cover.size
    changed_ratio = diff / total
    lsb_ones = np.sum(stego.flatten() & 1)
    p_lsb_1 = lsb_ones / total
    
    flat = stego.flatten()
    counts = np.bincount(flat, minlength=256)
    chi2 = 0.0
    df = 0
    for i in range(0, 256, 2):
        n_even = counts[i]
        n_odd = counts[i+1]
        n_total = n_even + n_odd
        if n_total > 0:
            expected = n_total / 2.0
            chi2 += ((n_even - expected)**2) / expected
            chi2 += ((n_odd - expected)**2) / expected
            df += 1
    if df > 0:
        z = (chi2 - df) / math.sqrt(2 * df)
        p_val = 0.5 * math.erfc(z / math.sqrt(2))
    else:
        p_val = 1.0
    return p, s, changed_ratio, p_lsb_1, chi2, p_val

def plot_visuals(cover, stego, img_name, method_name):
    # НОВАЯ КАРТА РАЗНОСТИ: Красим измененные пиксели в красный
    diff = np.abs(cover.astype(int) - stego.astype(int))
    diff_map = np.zeros_like(cover)
    
    # Если хотя бы в одном канале (R, G или B) есть изменение > 0
    mask = np.sum(diff, axis=2) > 0 
    diff_map[mask] = [255, 0, 0] # Закрашиваем красным
    
    save_image(diff_map, f'StegoCrypto/results/difference_{img_name}_{method_name}.png')
    
    # Гистограмма
    plt.figure(figsize=(10, 5))
    plt.hist(cover.flatten(), bins=256, alpha=0.5, label='Cover', color='blue')
    plt.hist(stego.flatten(), bins=256, alpha=0.5, label='Stego', color='red')
    plt.title(f'Histogram: {img_name} ({method_name})')
    plt.legend()
    plt.savefig(f'StegoCrypto/results/histogram_{img_name}_{method_name}.png')
    plt.close()

# ==========================================
# 5. Основной запуск
# ==========================================
def run_stego_experiment(img_path, img_name, message, password, payload_percent):
    print(f"\n{'='*50}\nАнализ: {img_name} | Payload: {payload_percent}%\n{'='*50}")
    
    os.makedirs('StegoCrypto/imgs', exist_ok=True)
    os.makedirs('StegoCrypto/results', exist_ok=True)
    
    cover = load_image(img_path)
    save_image(cover, f'StegoCrypto/imgs/cover_{img_name}')
    
    capacity_bits = cover.size
    target_bits = int(capacity_bits * (payload_percent / 100.0))
    target_bytes = target_bits // 8
    
    base_message = message.encode('utf-8')
    if len(base_message) < target_bytes:
        padding_needed = target_bytes - len(base_message)
        message_bytes = base_message + b'A' * padding_needed
    else:
        message_bytes = base_message[:target_bytes]
        
    print(f"Размер встроенного сообщения: {len(message_bytes)} байт (заполнение {payload_percent}%)")
    
    encrypted_data = encrypt_message(message_bytes.decode('utf-8', errors='ignore'), password)
    
    stego_plain = embed_lsb_sequential(cover, message_bytes)
    stego_enc = embed_lsb_sequential(cover, encrypted_data)
    stego_rand = embed_lsb_random(cover, encrypted_data, password)
    
    prefix = f"{img_name}_p{payload_percent}"
    save_image(stego_plain, f'StegoCrypto/imgs/stego_plain_{prefix}.png')
    save_image(stego_enc, f'StegoCrypto/imgs/stego_encrypted_{prefix}.png')
    save_image(stego_rand, f'StegoCrypto/imgs/stego_random_{prefix}.png')
    
    methods = [("Plain LSB", stego_plain), ("Encrypted LSB", stego_enc), ("Random LSB", stego_rand)]
    metrics = []
    
    print(f"{'Метод':<15} | {'PSNR':<8} | {'SSIM':<8} | {'Changed':<8} | {'P(LSB=1)':<10} | {'chi2':<8} | {'p-value':<8}")
    print("-" * 85)
    
    for name, stego in methods:
        p, s, cr, p1, c2, pv = calculate_metrics(cover, stego)
        metrics.append([name, p, s, cr, p1, c2, pv])
        
        # Считаем количество измененных пикселей (компонент) для вывода
        changed_pixels = int(cr * cover.size)
        
        print(f"{name:<15} | {p:.2f}     | {s:.4f}   | {cr:.4f}   | {p1:.4f}     | {c2:.2f}   | {pv:.4f}")
        
        if name == "Encrypted LSB":
            print(f" -> Изменено пикселей (компонент): {changed_pixels} (смотрите карту: difference_{prefix}.png)")
            plot_visuals(cover, stego, img_name, prefix)
    
    with open(f'StegoCrypto/results/{prefix}_metrics.csv', 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerow(['Method', 'PSNR', 'SSIM', 'Changed_ratio', 'P_LSB_1', 'Chi2', 'P_value'])
        writer.writerows(metrics)

# ==========================================
# ЗАПУСК
# ==========================================
MESSAGE = "Hello, this is a secret message for the lab!"
PASSWORD = "SuperSecretPassword123"

run_stego_experiment('gradient.jpg', 'gradient.jpg', MESSAGE, PASSWORD, 1)
run_stego_experiment('gradient.jpg', 'gradient.jpg', MESSAGE, PASSWORD, 5)

run_stego_experiment('checkerboard.jpg', 'checkerboard.jpg', MESSAGE, PASSWORD, 1)
run_stego_experiment('checkerboard.jpg', 'checkerboard.jpg', MESSAGE, PASSWORD, 5)

print("\nГотово! Все картинки, графики и таблицы сохранены в StegoCrypto/")